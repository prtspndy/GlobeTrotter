{
  "name": "globetrotter",
  "version": "1.0.0",
  "private": true,
  "description": "Personalized travel planning platform built with React, Express, and MongoDB",
  "scripts": {
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:lint": "npm --prefix client run lint",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "server:test": "npm --prefix server test",
    "seed": "npm --prefix server run seed"
  },
  "keywords": [
    "mern",
    "travel-planner",
    "react",
    "express",
    "mongodb",
    "node"
  ],
  "author": "GlobeTrotter Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
